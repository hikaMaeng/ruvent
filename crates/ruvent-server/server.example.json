{
  "listen": "127.0.0.1:7400",
  "journal": "data/journal",
  "durability": "strict",
  "credentials": [
    {
      "name": "workers",
      "token": "workers-secret-change-me",
      "methods": ["register_claimable", "register_dispatch", "claim", "complete", "subscribe", "unsubscribe"],
      "types": ["10-29", "100-199"]
    },
    {
      "name": "proxy",
      "token": "proxy-secret-change-me",
      "methods": ["register_claimable", "register_dispatch", "delete", "claim", "complete", "subscribe", "unsubscribe"],
      "types": ["10-19", "100-199"],
      "delegate": true
    },
    {
      "name": "ops",
      "token": "ops-secret-change-me",
      "methods": ["operate"]
    }
  ],
  "engine": { "backlog_page": 1024, "ack_every": 256, "reconnect_grace_ms": 3000 },
  "producers": { "linger_ms": 3600000, "max_entries": 1000000 },
  "memory": { "limit": 8589934592, "high_watermark": 0.8 },
  "storage": { "segment_bytes": 67108864, "disk_capacity": 107374182400 },
  "types": {
    "default": { "isolate_after": 5 },
    "rules": [
      { "types": ["20-29"], "isolate_after": 3, "serialize_group": true },
      { "types": ["100-199"], "volatile": true }
    ]
  },
  "connection": {
    "unsent": 268435456,
    "close_ms": 5000,
    "keepalive": { "idle_ms": 15000, "interval_ms": 5000, "retries": 3, "user_timeout_ms": 30000 }
  },
  "snapshot": {
    "directory": "data/snapshots",
    "types": ["10-19"],
    "max_events": 4096,
    "max_age_ms": 5000
  }
}
