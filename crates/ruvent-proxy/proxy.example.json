{
  "listen": "0.0.0.0:8400",
  "upstream": { "servers": ["127.0.0.1:7400", "127.0.0.1:7401"], "token": "proxy-secret-change-me" },
  "auth": {
    "mode": "worker",
    "tokens": [
      { "token": "dev-token", "user": "dev", "channels": ["chat.*"] }
    ],
    "worker": {
      "channel": "auth.requests",
      "type": "authenticate",
      "timeout_ms": 5000
    }
  },
  "channels": ["public.*"],
  "user_buffer": 1024,
  "delegate": true,
  "reconnect": { "initial_ms": 50, "max_ms": 1000, "draining_ms": 30000 },
  "exchange": { "deadline_ms": 30000, "lease_ms": 5000 }
}
